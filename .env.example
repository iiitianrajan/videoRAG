# Copy these names to .env and supply keys from the respective providers.
GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY remains supported for compatibility.
GEMINI_API_KEY=your_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v2.5
WHISPER_MODEL=small
GROQ_MODEL=groq/openai/gpt-oss-120b
GEMINI_MODEL=gemini/gemini-3.8-flash
MISTRAL_MODEL=mistral/mistral-small-latest
